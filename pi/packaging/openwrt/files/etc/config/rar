# RAR dual-band radio services. Edit with `uci set rar.<section>.<option>=...`
# then `uci commit rar` — both services restart automatically.

config global 'global'
	# 1 = detailed debug logging from rar-bridge and rar-led: every plugin
	# message, Meshtastic send/receive with radio confirmation, delivery to
	# ATAK, de-duplication, state.json and LED changes. Watch it with:
	#   logread -f -e rar
	option debug '0'

config bridge 'bridge'
	option enabled '1'
	# RAK4631 serial device: uart2 on pins 27/28 (dtoverlay=uart2), because
	# the WM1302 HAT's GPS uses the primary UART on pins 8/10. Check the name
	# with: dmesg | grep fe201400. The RAK's Serial module must be in PROTO
	# mode at this baud rate.
	option serial_device '/dev/ttyAMA2'
	option baud '115200'
	# Meshtastic channel index used for TAK traffic, and hop limit
	# (0 = use the radio's configured hop limit).
	option channel '0'
	option hop_limit '0'

	# HaLow neighbor detection via batman-adv.
	option mesh_iface 'bat0'
	# Stand-in: replace with the HaLow 802.11s interface (e.g. wlan0).
	# While left as HALOW_IFACE, neighbors on any batman-adv interface count.
	option halow_iface 'HALOW_IFACE'
	option poll '5s'
	option neighbor_max_age '5s'
	option down_after '15s'
	option up_after '30s'

	# Ports the ATAK plugin sends to, and ATAK's UDP input on the EUD.
	option listen_auto ':6700'
	option listen_always ':6701'
	option eud_port '4242'
	# Also deliver received traffic to this node's DHCP clients (in
	# addition to EUDs learned from plugin traffic).
	option use_dhcp_leases '1'

	# Drop Meshtastic copies of traffic the EUD already got over HaLow.
	option suppress_halow_dupes '1'
	option mcast_iface 'br-ahwlan'

	# Meshtastic airtime limits.
	option pli_interval '60s'
	option pli_min_interval '15s'
	option pli_move_meters '50'
	option tx_gap '3s'

	option log_level 'info'

config led 'led'
	option enabled '1'
	option gpiochip 'gpiochip0'
	# BCM GPIO numbers (physical pins 36 / 38 / 40).
	# Blue = HaLow, green = Meshtastic. Red is reserved (planned: low
	# battery) and held off.
	option red '16'
	option green '20'
	option blue '21'
	# 0 = common-cathode LED, anodes on the pins (pin high = on).
	# 1 = common-anode LED (pin low = on).
	option active_low '0'
	# Hook for the reserved red LED: a file containing on, off or blink,
	# e.g. written by a future battery monitor. Unset = red unused.
	#option red_file '/var/run/rar/led-red'
