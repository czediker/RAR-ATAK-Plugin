#!/bin/sh /etc/rc.common
# rar-led: shows the rar-bridge status on the RGB LED.

START=94
STOP=11
USE_PROCD=1
PROG=/usr/bin/rar-led

opt() {
	local val
	config_get val led "$1"
	[ -n "$val" ] && procd_append_param command "-$2" "$val"
}

start_service() {
	config_load rar
	local enabled active_low
	config_get_bool enabled led enabled 1
	[ "$enabled" = 1 ] || return 0

	procd_open_instance
	procd_set_param command "$PROG"
	opt gpiochip gpiochip
	opt red red
	opt green green
	opt blue blue
	config_get_bool active_low led active_low 1
	if [ "$active_low" = 1 ]; then
		procd_append_param command "-active-low=true"
	else
		procd_append_param command "-active-low=false"
	fi

	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger rar
}
