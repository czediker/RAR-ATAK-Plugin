#!/bin/sh /etc/rc.common
# rar-bridge: sends ATAK chat/position traffic over Meshtastic when the HaLow
# mesh has no neighbors (port 6700) or always (port 6701), and delivers
# traffic received over Meshtastic to the local EUD.

START=95
STOP=10
USE_PROCD=1
PROG=/usr/bin/rar-bridge

# opt <uci option> <flag>: pass the option through if it is set.
opt() {
	local val
	config_get val bridge "$1"
	[ -n "$val" ] && procd_append_param command "-$2" "$val"
}

# bool <uci option> <flag>
bool() {
	local val
	config_get_bool val bridge "$1"
	[ -n "$val" ] || return 0
	if [ "$val" = 1 ]; then
		procd_append_param command "-$2=true"
	else
		procd_append_param command "-$2=false"
	fi
}

start_service() {
	config_load rar
	local enabled leases debug
	config_get_bool enabled bridge enabled 1
	[ "$enabled" = 1 ] || return 0

	procd_open_instance
	procd_set_param command "$PROG"
	opt serial_device serial
	opt baud baud
	opt channel channel
	opt hop_limit hop-limit
	opt mesh_iface mesh-iface
	opt halow_iface halow-iface
	opt poll poll
	opt neighbor_max_age neighbor-max-age
	opt down_after down-after
	opt up_after up-after
	opt listen_auto listen-auto
	opt listen_always listen-always
	opt eud_port eud-port
	opt mcast_iface mcast-iface
	opt pli_interval pli-interval
	opt pli_min_interval pli-min-interval
	opt pli_move_meters pli-move-meters
	opt tx_gap tx-gap
	opt log_level log-level
	bool suppress_halow_dupes suppress-halow-dupes
	config_get_bool leases bridge use_dhcp_leases 1
	[ "$leases" = 1 ] || procd_append_param command "-lease-file="

	config_get_bool debug global debug 0
	[ "$debug" = 1 ] && procd_append_param command -debug

	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger rar
}
